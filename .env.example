# Copy to .env (never commit .env). All variables are optional.

# --- What to serve (one of) ---
# REPO_URL=https://github.com/owner/repo
# REPO_PATH=/repo                 # path inside the container (REPO_HOST_PATH is mounted there)
# GRAPH_FILE=/data/graph.json     # pre-computed graph (python -m repo_knowledge_graph build)
# REPO_HOST_PATH=../my-repo       # host directory mounted read-only on /repo by compose.yml
# GITHUB_TOKEN=                   # private repositories

# --- Server ---
# PORT=4000
# TRANSPORT=http                  # stdio | http | sse
# LOG_LEVEL=INFO

# --- Graph construction ---
# EXTRACT_ENTITIES=true
# DESCRIBE_NODES=false            # LLM summaries of chunks (needs OPENAI_BASE_URL)
# GIT_HISTORY=false
# MAX_COMMITS=200
# MAX_FILE_SIZE=1000000
# CODE_CHUNK_SIZE=2000

# --- Java / framework enrichment ---
# ENRICHERS=auto                  # auto | none | build,supply_chain,spring_config,spring_beans,openapi,spring_web,web_routes,graphql,spring_data_jpa,mybatis,spring_messaging,spring_tests,spring_security,security
# OSV_LOOKUP=false                # opt-in: check_dependencies queries osv.dev (sends group:artifact:version only)
# OSV_CACHE_FILE=~/.cache/repo-knowledge-graph/osv.json
# MASK_CONFIG_VALUES=true         # mask secret-looking values of application*.yml / .properties
# MAX_CALL_EDGES=0                # cap on 'calls' / 'uses_type' edges (0 = unlimited)

# --- Code index ---
# INDEX_TYPE=keyword-only         # keyword-only | embedding-only | hybrid
# INDEX_BACKEND=lancedb           # lancedb | weaviate
# EMBEDDER_TYPE=sentence-transformers   # sentence-transformers | openai
# EMBED_MODEL_NAME=Salesforce/SFR-Embedding-Code-400M_R
# OPENAI_EMBED_BASE_URL=http://localhost:8001/v1   # any OpenAI-compatible embedding server

# --- LLM (chunk descriptions, smolagents demo) ---
# OPENAI_BASE_URL=http://localhost:8000/v1        # any OpenAI-compatible chat server
# OPENAI_TOKEN=no-need
# MODEL_NAME=HuggingFaceTB/SmolLM3-3B

# --- Optional Langfuse tracing ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
